{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "d92e57b1-3a04-4c6e-9173-84c65f7a1904",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "WebRouting": {
        "ApplicationUrlDetection": "FirstRequest"
      }
    }
  },
  "ResourceSpace": {
    "BaseUrl": "https://dam.example.org",
    "PublicBaseUrl": null,
    "ApiUser": "umbraco_api",
    "ApiKey": "",
    "DefaultDeliverySize": "scr",
    "PreviewSizes": [
      "thm",
      "pre",
      "scr",
      "hpr"
    ],
    "TitleFieldId": 8,
    "CaptionFieldId": 18,
    "CreditFieldId": 10,
    "BlockRestrictedAssets": true,
    "AllowedArchiveStates": [
      0
    ],
    "FallbackImageUrl": null,
    "AssetCacheDuration": "00:05:00",
    "MissingAssetCacheDuration": "00:00:30",
    "HttpTimeout": "00:00:10"
  }
}